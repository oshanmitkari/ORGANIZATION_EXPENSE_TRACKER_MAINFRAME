       IDENTIFICATION DIVISION.
       PROGRAM-ID. EMPCHECK.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EMPLOYEE-MASTER ASSIGN TO EMPVSAM
               ORGANIZATION IS INDEXED
               ACCESS MODE IS RANDOM
               RECORD KEY IS EMPLOYEE-KEY
               FILE STATUS IS FS-EMP.
       DATA DIVISION.
       FILE SECTION.
       FD EMPLOYEE-MASTER.
       COPY EMPCOPY.
       WORKING-STORAGE SECTION.
       01 FS-EMP PIC XX.
       PROCEDURE DIVISION.
           OPEN INPUT EMPLOYEE-MASTER
           IF FS-EMP NOT = '00'
               DISPLAY 'EMPLOYEE OPEN ERROR FS=' FS-EMP
               MOVE 12 TO RETURN-CODE
               GOBACK
           END-IF
           MOVE 'E0001001' TO EMPLOYEE-KEY
           READ EMPLOYEE-MASTER KEY IS EMPLOYEE-KEY
               INVALID KEY
                   DISPLAY 'EMPLOYEE VERIFY NOT FOUND ID=' EMPLOYEE-KEY
                   MOVE 8 TO RETURN-CODE
               NOT INVALID KEY
                   DISPLAY 'EMPLOYEE VERIFY ID=' EMPLOYEE-KEY
                       ' STATUS=' EMPLOYEE-STATUS
                       ' NAME=' EMPLOYEE-NAME
           END-READ
           CLOSE EMPLOYEE-MASTER
           GOBACK.
