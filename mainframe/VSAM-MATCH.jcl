//VSAMMAT JOB (ACCT),'EXPENSE VSAM MATCH',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* Requires a previously defined/populated 80-byte employee KSDS.
//* Build VSAMLOOK from VSAMLOOK.cbl and use the approved compiler PROC.
//MATCH    EXEC PGM=VSAMLOOK
//STEPLIB  DD DSN=&SYSUID..LOADLIB,DISP=SHR
//TRANSIN  DD DSN=&SYSUID..EXPENSE.CLEAN,DISP=SHR
//EMPVSAM  DD DSN=&SYSUID..EXPENSE.MASTER,DISP=SHR
//MATCHOUT DD DSN=&SYSUID..EXPENSE.MATCHED,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//REJOUT   DD DSN=&SYSUID..EXPENSE.UNKNOWN,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(2,2),RLSE),
//            DCB=(RECFM=FB,LRECL=110,BLKSIZE=0)
