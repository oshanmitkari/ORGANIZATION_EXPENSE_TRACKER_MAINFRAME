//EXPSUM   JOB (ACCT),'EXPENSE ICETOOL SUMMARY',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* VALID INPUT IS FB,LRECL=80. AMOUNT IS NINE DIGITS OF INTEGER CENTS.
//TOOL     EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//TOOLIN   DD *
  COUNT FROM(VALID)
  STATS FROM(VALID) ON(33,9,ZD)
  DISPLAY FROM(VALID) LIST(REPORT) -
    TITLE('APEX EXPENSE DETAIL') -
    HEADER('TRANSACTION') ON(1,12,CH) -
    HEADER('EMPLOYEE') ON(13,8,CH) -
    HEADER('CATEGORY') ON(29,4,CH) -
    HEADER('AMOUNT CENTS') ON(33,9,ZD)
/*
//VALID    DD DSN=&SYSUID..EXPENSE.VALID,DISP=SHR
//REPORT   DD SYSOUT=*
