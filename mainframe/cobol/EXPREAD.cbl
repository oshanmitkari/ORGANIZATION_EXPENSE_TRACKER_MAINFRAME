       IDENTIFICATION DIVISION.
       PROGRAM-ID. EXPREAD.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EXPENSE-MASTER ASSIGN TO EXPVSAM
               ORGANIZATION IS INDEXED
               ACCESS MODE IS RANDOM
               RECORD KEY IS MASTER-KEY
               FILE STATUS IS FS-VSAM.
           SELECT REQUEST-IN ASSIGN TO REQUEST
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS FS-IN.
           SELECT RESULT-OUT ASSIGN TO RESULT
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS FS-OUT.
       DATA DIVISION.
       FILE SECTION.
       FD EXPENSE-MASTER.
       01 MASTER-RECORD.
          05 MASTER-KEY PIC X(12).
          05 FILLER PIC X(68).
       FD REQUEST-IN RECORDING MODE F.
       01 REQUEST-RECORD PIC X(12).
       FD RESULT-OUT RECORDING MODE F.
       01 RESULT-RECORD PIC X(120).
       WORKING-STORAGE SECTION.
       COPY EXPCOPY.
       01 REQUEST-ID PIC X(12).
       01 FS-VSAM PIC XX.
       01 FS-IN PIC XX.
       01 FS-OUT PIC XX.
       01 EOF-SW PIC X VALUE 'N'.
          88 AT-EOF VALUE 'Y'.
       01 WHY PIC X(40).
       PROCEDURE DIVISION.
           OPEN INPUT REQUEST-IN EXPENSE-MASTER OUTPUT RESULT-OUT
           IF FS-IN NOT = '00'
              OR FS-VSAM NOT = '00'
              OR FS-OUT NOT = '00'
               MOVE 12 TO RETURN-CODE
               GOBACK
           END-IF
           PERFORM UNTIL AT-EOF
               READ REQUEST-IN
                   AT END SET AT-EOF TO TRUE
                   NOT AT END PERFORM READ-ONE
               END-READ
           END-PERFORM
           CLOSE REQUEST-IN EXPENSE-MASTER RESULT-OUT
           GOBACK.
       READ-ONE.
           MOVE REQUEST-RECORD TO REQUEST-ID
           MOVE REQUEST-ID TO MASTER-KEY
           MOVE SPACES TO WHY
           READ EXPENSE-MASTER KEY IS MASTER-KEY
               INVALID KEY MOVE 'NOT FOUND' TO WHY
               NOT INVALID KEY MOVE 'FOUND' TO WHY
           END-READ
           MOVE SPACES TO RESULT-RECORD
           STRING REQUEST-ID DELIMITED BY SIZE
               '|' DELIMITED BY SIZE
               WHY DELIMITED BY SIZE INTO RESULT-RECORD
           END-STRING
           WRITE RESULT-RECORD.
