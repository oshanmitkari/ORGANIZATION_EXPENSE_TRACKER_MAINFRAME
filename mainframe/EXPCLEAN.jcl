//EXPCLEAN JOB (ACCT),'EXPENSE CLEAN',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//* STEP 1: SORT BY EMPLOYEE ID; REMOVE ONLY EXACT DUPLICATE RECORDS
//CLEAN    EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..EXPENSE.TRANS,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..EXPENSE.CLEAN,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(13,8,CH,A,1,80,CH,A)
  SUM FIELDS=NONE
/*
