       IDENTIFICATION DIVISION.
       PROGRAM-ID. EXPRPT.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EXPENSE-MASTER ASSIGN TO EXPVSAM
               ORGANIZATION IS INDEXED
               ACCESS MODE IS SEQUENTIAL
               RECORD KEY IS MASTER-KEY
               FILE STATUS IS FS-VSAM.
           SELECT REPORT-OUT ASSIGN TO RPTOUT
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS FS-OUT.
       DATA DIVISION.
       FILE SECTION.
       FD EXPENSE-MASTER.
       01 MASTER-RECORD.
          05 MASTER-KEY PIC X(12).
          05 FILLER PIC X(68).
       FD REPORT-OUT RECORDING MODE F.
       01 REPORT-RECORD PIC X(120).
       WORKING-STORAGE SECTION.
       COPY EXPCOPY.
       01 FS-VSAM PIC XX.
       01 FS-OUT PIC XX.
       01 EOF-SW PIC X VALUE 'N'.
       01 CNT PIC 9(9) COMP-5 VALUE 0.
       01 TOTAL-PAISE PIC 9(15) COMP-5 VALUE 0.
       01 CNT-DISPLAY PIC 9(9).
       01 TOTAL-DISPLAY PIC 9(15).
       01 AMOUNT-NUM PIC 9(9) COMP-3.
       PROCEDURE DIVISION.
           OPEN INPUT EXPENSE-MASTER OUTPUT REPORT-OUT
           IF FS-VSAM NOT = '00' OR FS-OUT NOT = '00'
               MOVE 12 TO RETURN-CODE
               GOBACK
           END-IF
           PERFORM UNTIL EOF-SW = 'Y'
               READ EXPENSE-MASTER NEXT RECORD
                   AT END MOVE 'Y' TO EOF-SW
                   NOT AT END PERFORM SUM-ONE
               END-READ
           END-PERFORM
           MOVE CNT TO CNT-DISPLAY
           MOVE TOTAL-PAISE TO TOTAL-DISPLAY
           MOVE SPACES TO REPORT-RECORD
           STRING 'TOTAL|' DELIMITED BY SIZE
               CNT-DISPLAY DELIMITED BY SIZE
               '|' DELIMITED BY SIZE
               TOTAL-DISPLAY DELIMITED BY SIZE INTO REPORT-RECORD
           END-STRING
           WRITE REPORT-RECORD
           CLOSE EXPENSE-MASTER REPORT-OUT
           GOBACK.
       SUM-ONE.
           MOVE MASTER-RECORD TO EXPENSE-RECORD
           MOVE SPACES TO REPORT-RECORD
           STRING EXP-ID DELIMITED BY SIZE
               '|' DELIMITED BY SIZE
               EXP-EMP-ID DELIMITED BY SIZE
               '|' DELIMITED BY SIZE
               EXP-DATE DELIMITED BY SIZE
               '|' DELIMITED BY SIZE
               EXP-CATEGORY DELIMITED BY SIZE
               '|' DELIMITED BY SIZE
               EXP-AMOUNT DELIMITED BY SIZE
               '|' DELIMITED BY SIZE
               EXP-DESCRIPTION DELIMITED BY SIZE
               INTO REPORT-RECORD
           END-STRING
           WRITE REPORT-RECORD
           ADD 1 TO CNT
           IF EXP-AMOUNT IS NUMERIC
               MOVE EXP-AMOUNT TO AMOUNT-NUM
               ADD AMOUNT-NUM TO TOTAL-PAISE
           END-IF.
