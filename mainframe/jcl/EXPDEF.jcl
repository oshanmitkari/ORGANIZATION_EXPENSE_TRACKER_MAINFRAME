//EXPDEF   JOB (ACCT),'EXPENSE KSDS DEFINE',CLASS=A,MSGCLASS=X
//* Explicit provisioning step. Never run from API startup.
//* Fails if cluster exists.
//DEFINE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE CLUSTER (NAME(Z86073.EXPTRK.MASTER) INDEXED KEYS(12 0) -
         RECORDSIZE(80 80) SHAREOPTIONS(2 3)) -
          DATA (NAME(Z86073.EXPTRK.MASTER.DATA) CYLINDERS(1 1)) -
          INDEX (NAME(Z86073.EXPTRK.MASTER.INDEX) CYLINDERS(1 1))
/*
