//RPTCHECK JOB (ACCT),'EXPENSE REPORT CHECK',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* SORT APPROVED EXPENSES BY AMOUNT DESCENDING
//SORTD    EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..EXPENSE.VALID,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..EXPENSE.REPORT,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(33,9,CH,D)
/*
//* COMPARE INPUT/OUTPUT COUNTS USING THE CNTCHECK LOAD MODULE
//CHECK    EXEC PGM=CNTCHECK,COND=(0,NE,SORTD)
//STEPLIB  DD DSN=&SYSUID..LOADLIB,DISP=SHR
//INFILE   DD DSN=&SYSUID..EXPENSE.VALID,DISP=SHR
//OUTFILE  DD DSN=&SYSUID..EXPENSE.REPORT,DISP=SHR
//* KEEP THE REPORT ONLY WHEN COUNTS MATCH; OTHERWISE DELETE IT
// IF (CHECK.RC = 0) THEN
//OKMSG    EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD *
EXPENSE REPORT COUNT CHECK PASSED - REPORT RETAINED
/*
//SYSUT2   DD SYSOUT=*
//SYSIN    DD DUMMY
// ELSE
//DELBAD   EXEC PGM=IEFBR14
//BAD      DD DSN=&SYSUID..EXPENSE.REPORT,DISP=(OLD,DELETE)
//ERRMSG   EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD *
ERROR: EXPENSE REPORT COUNT CHECK FAILED - REPORT DELETED
/*
//SYSUT2   DD SYSOUT=*
//SYSIN    DD DUMMY
//* Preserve a failing job result after cleanup and operator messaging.
//FAILRC   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  SET MAXCC=12
/*
// ENDIF
