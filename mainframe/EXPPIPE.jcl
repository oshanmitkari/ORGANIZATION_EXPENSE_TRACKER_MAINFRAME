//EXPPIPE  JOB (ACCT),'EXPENSE PIPELINE',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* LOAD MATCH2 AND EXPVALID IN YOUR LOAD LIBRARY BEFORE SUBMITTING.
//* STEP 1: REMOVE EXACT DUPLICATES AND SORT BY EMPLOYEE ID
//CLEAN    EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..EXPENSE.TRANS,DISP=SHR
//SORTOUT  DD DSN=&&CLEAN,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(13,8,CH,A,1,80,CH,A)
  SUM FIELDS=NONE
/*
//* STEP 2: MATCH TRANSACTION EMPLOYEE IDs AGAINST EMPLOYEE MASTER
//MATCH    EXEC PGM=MATCH2
//STEPLIB  DD DSN=&SYSUID..LOADLIB,DISP=SHR
//FILE1    DD DSN=&&CLEAN,DISP=(OLD,DELETE)
//FILE2    DD DSN=&SYSUID..EMPLOYEE.MASTER,DISP=SHR
//FILE3    DD DSN=&SYSUID..EXPENSE.MATCHED,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(5,5),RLSE),DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//FILE4    DD DSN=&SYSUID..EXPENSE.UNKNOWN,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(2,2),RLSE),DCB=(RECFM=FB,LRECL=110,BLKSIZE=0)
//* STEP 3: VALIDATE AMOUNT, DATE AND CATEGORY
//* Skip validation when MATCH returns RC 12 or higher.
//VALID    EXEC PGM=EXPVALID,COND=(12,LE,MATCH)
//STEPLIB  DD DSN=&SYSUID..LOADLIB,DISP=SHR
//TRANSIN  DD DSN=&SYSUID..EXPENSE.MATCHED,DISP=SHR
//GOODOUT  DD DSN=&SYSUID..EXPENSE.VALID,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(5,5),RLSE),DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//REJOUT   DD DSN=&SYSUID..EXPENSE.REJECT,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(2,2),RLSE),DCB=(RECFM=FB,LRECL=110,BLKSIZE=0)
//* STEP 4: GENERATE REPORT AND VERIFY COUNTS (SEE RPTCHECK.JCL)
//REPORT   EXEC PGM=SORT,COND=(12,LE,VALID)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..EXPENSE.VALID,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..EXPENSE.REPORT,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(5,5),RLSE),DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(33,9,CH,D)
/*
